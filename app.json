{
  "expo": {
    "name": "Mi Mercado",
    "slug": "mercado-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "mercadoapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#16A34A"
    },
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#16A34A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aure.mimercado",
      "label": "Mi Mercado",
      "adaptiveIcon": {
        "backgroundColor": "#16A34A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-print",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "06824e1c-8115-423e-82c2-0623426c2fc9"
      }
    },
    "owner": "aurex"
  }
}